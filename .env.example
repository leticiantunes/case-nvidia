# Provedor de LLM (interface compativel com OpenAI).
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
# NVIDIA NIM: LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Reranking do RAG
COHERE_API_KEY=

# Banco relacional (sobe com docker compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/startups_db
